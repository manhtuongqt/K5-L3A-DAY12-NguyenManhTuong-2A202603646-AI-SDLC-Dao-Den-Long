{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dao Den Long - 3D third-person game with a headless test mode (Day 12 AI SDLC lab)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "headless": "node src/headless.js",
    "test": "node --test tests/*.test.js",
    "start": "node scripts/play.mjs",
    "bench": "node scripts/bench.mjs --seed 42 --duration 30 --out bench.json",
    "soak": "node --expose-gc scripts/soak.mjs --seed 7 --nights 10 --out soak.json"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "vite": "^6.0.7"
  }
}
